{
  "name": "genesys-overlay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:extension": "pnpm --filter @genesys/extension dev",
    "host": "pnpm --filter @genesys/host start",
    "host:local": "pnpm --filter @genesys/host start -- --local",
    "package": "pnpm --filter @genesys/extension package",
    "package:store": "pnpm --filter @genesys/extension package:store",
    "package:host": "pnpm --filter @genesys/host package",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "~5.9"
  },
  "license": "MIT"
}
