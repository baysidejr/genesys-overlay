{
  "manifest_version": 3,
  "name": "Genesys Overlay",
  "version": "0.3.0",
  "description": "Unofficial fan-made Genesys RPG dice and character sheets for Alchemy RPG and other VTTs. Not affiliated with Fantasy Flight Games.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Genesys Overlay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.alchemyrpg.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.trycloudflare.com/join*"
      ],
      "js": [
        "invite.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
