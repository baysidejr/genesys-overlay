{
  "name": "@genesys/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --mode development",
    "build": "node scripts/build.mjs",
    "preview:dice": "vite --config vite.preview.config.ts",
    "package": "node scripts/package.mjs",
    "package:store": "node scripts/package.mjs --store",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genesys/shared": "workspace:^",
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@genesys/host": "workspace:^",
    "@types/chrome": "^0.3.6",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
